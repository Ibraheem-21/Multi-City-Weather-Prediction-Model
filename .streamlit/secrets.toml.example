# Optional: paste keys here for Streamlit Cloud (Settings → Secrets)
# Or set environment variables locally.

# Best free option — Google AI Studio (~1,500 req/day, no card)
# GEMINI_API_KEY = "your-key"

# Fast free option — Groq (~1K–14K req/day, no card)
# GROQ_API_KEY = "your-key"

# Free model gateway — OpenRouter (50 req/day free)
# OPENROUTER_API_KEY = "your-key"

# Optional paid fallback
# OPENAI_API_KEY = "your-key"
